#!/usr/bin/env python3
"""Advisory persistence nudge for Stop and SessionEnd.

An alert that always fires is wallpaper. The thresholds and the cooldown are
the feature, not plumbing: the failure mode of this whole plugin is a nudge
the operator learns to ignore.

This hook never blocks. It exits 0 on every path, including every failure.
"""
import json
import os
import sys
import time
from pathlib import Path

# --- Tunable constants. Start conservative; loosen only if you find yourself
# --- wishing the nudge had fired. Tightening after habituation does not work.
MIN_TOOL_CALLS = 25          # a session lighter than this rarely holds a skill
MIN_EDITS = 3                # reading is not doing; require real mutation
COOLDOWN_SECONDS = 6 * 3600  # at most one nudge per 6h, shared by both events
# Substrings matched case-insensitively against tool names. A match is
# necessary but not sufficient: measure() counts the call only when the
# input also names a target under file_path or notebook_path. So TodoWrite
# matches "write", names no target, and does not count; MultiEdit and
# NotebookEdit both name one and do.
#
# Widening this list is not made safe by that gate. The gate rejects tools
# that name no target — it says nothing about read-only tools that do.
# NotebookRead carries notebook_path and Read carries file_path; both are
# excluded today only because their names contain no marker. Add "read" or
# "notebook" here and pure reading counts as editing at full weight.
# Narrowing it instead misses real work.
EDIT_MARKERS = ("edit", "write", "create", "str_replace")

DEFAULT_HOME = "~/.claude/growth-loop"  # where ledger/state live if unset; changing loses continuity with prior installs


def home():
    # Set-but-empty is not an override: os.environ.get returns "" rather than
    # the default, and Path("") is Path("."), which would drop ledger.jsonl
    # and nudge-state.json into the working directory. State living outside
    # any repository is the point.
    return Path(os.environ.get("GROWTH_LOOP_HOME") or DEFAULT_HOME).expanduser()


def measure(path):
    """Return (tool_calls, edits, [target, ...]) from a transcript.

    A target is whichever of file_path or notebook_path the tool named.
    """
    calls = edits = 0
    files = []
    try:
        handle = open(path, "r", encoding="utf-8", errors="replace")
    except OSError:
        return 0, 0, []
    with handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except (ValueError, TypeError):
                continue
            if not isinstance(rec, dict):
                continue
            message = rec.get("message")
            if not isinstance(message, dict):
                continue
            content = message.get("content")
            if not isinstance(content, list):
                continue
            for block in content:
                if not isinstance(block, dict) or block.get("type") != "tool_use":
                    continue
                calls += 1
                name = str(block.get("name", "")).lower()
                if any(marker in name for marker in EDIT_MARKERS):
                    target = None
                    payload = block.get("input")
                    if isinstance(payload, dict):
                        target = payload.get("file_path") or payload.get("notebook_path")
                    # A tool that names no file changed no file: TodoWrite
                    # matches "write" by name but carries no file_path or
                    # notebook_path, so it must not count as an edit.
                    # NotebookEdit's target lives under notebook_path, not
                    # file_path — miss that key and a notebook-only session
                    # can never nudge. Gating the count on target also means
                    # edits > 0 implies files is non-empty, which is what
                    # keeps message() from ever rendering "0 file(s) ()" —
                    # there is no longer a code path where edits are counted
                    # without a file to show for them.
                    if target:
                        edits += 1
                        if target not in files:
                            files.append(target)
    return calls, edits, files


def read_state():
    # A non-dict here (null, a list, a bare number) would make the caller's
    # .get() raise. The top-level guard would swallow that and exit 0, but
    # record() is never reached, so the state file never gets rewritten and
    # the nudge stays silent in that environment for good. Treat anything
    # that is not a dict as absent, so the next fire repairs the file.
    try:
        state = json.loads((home() / "nudge-state.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def record(session_id, calls, edits, files):
    """Stamp the cooldown, then append to the ledger. Never raises."""
    now = time.time()
    try:
        base = home()
        base.mkdir(parents=True, exist_ok=True)
        # State first: it is the guard against re-firing inside the cooldown
        # window, so it must land even if the ledger write below fails. A
        # missing ledger line only costs an audit record; a missing state
        # write reopens the habituation failure this file's docstring warns
        # about. Do not reorder this back to "ledger, then state."
        (base / "nudge-state.json").write_text(
            json.dumps({"last_nudge": now, "last_session": session_id}),
            encoding="utf-8")
        with open(base / "ledger.jsonl", "a", encoding="utf-8") as fh:
            fh.write(json.dumps({
                "ts": now,
                "session": session_id,
                "stats": {"tool_calls": calls, "edits": edits, "files": files},
            }) + "\n")
    except OSError:
        pass


def message(calls, edits, files):
    shown = ", ".join(Path(f).name for f in files[:4])
    if len(files) > 4:
        shown += ", +%d more" % (len(files) - 4)
    return (
        "This session ran %d tool calls with %d edits across %d file(s) (%s). "
        "That is enough weight that something in it may be worth keeping: a "
        "procedure that took real work to get right belongs in "
        "/growth-loop:learn, and a durable fact about how this person works "
        "belongs in /growth-loop:profile. If it was routine, say nothing and "
        "move on." % (calls, edits, len(files), shown)
    )


def main():
    try:
        raw = sys.stdin.read()
    except (OSError, ValueError):
        return 0
    if not raw.strip():
        return 0
    try:
        payload = json.loads(raw)
    except (ValueError, TypeError):
        return 0
    if not isinstance(payload, dict):
        return 0

    transcript = payload.get("transcript_path")
    session_id = payload.get("session_id") or "unknown"
    event = payload.get("hook_event_name") or "Stop"
    if not transcript or not Path(transcript).is_file():
        return 0

    # A dict carrying a truthy non-numeric last_nudge (a hand-edited ISO
    # timestamp, say) raises here. read_state()'s dict guard does not cover
    # it, and the top-level guard would swallow the error before record()
    # rewrites the file — leaving this environment permanently silent, the
    # same end state that guard exists to prevent, one level down.
    try:
        last = float(read_state().get("last_nudge", 0) or 0)
    except (TypeError, ValueError):
        last = 0.0
    if time.time() - last < COOLDOWN_SECONDS:
        return 0

    calls, edits, files = measure(transcript)
    if calls < MIN_TOOL_CALLS or edits < MIN_EDITS:
        return 0

    record(session_id, calls, edits, files)
    text = message(calls, edits, files)

    if event == "SessionEnd":
        # SessionEnd has no next model call, and its stdout does not reach
        # Claude. Address the human instead.
        print(json.dumps({"systemMessage": text}))
    else:
        # Stop, exit 0 with JSON: additionalContext reaches Claude as a system
        # reminder on the next model call. Never `decision: block` — a nudge
        # that hijacks control is not a nudge, and it burns the block cap.
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "Stop",
            "additionalContext": text,
        }}))
    return 0


if __name__ == "__main__":
    try:
        main()
    except Exception:      # a hook must never break a session
        pass
    sys.exit(0)
